{
  "name": "divhacks26-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Around Me iMessage agent for NYC using Photon, Gemini, Tiger Data, and Google Maps",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:maps-live": "tsx test/live/maps-live.ts",
    "test:backboard-live": "tsx test/live/backboard-live.ts",
    "test:photon-memory-live": "tsx test/live/photon-memory-live.ts",
    "test:ripple-live": "tsx test/live/ripple-live.ts",
    "demo:ripple": "tsx src/payments/ripple-demo.ts",
    "faucet": "tsx src/payments/faucet-cli.ts",
    "xrpl:dashboard": "tsx src/payments/xrpl-dashboard.ts",
    "xrpl:status": "tsx src/payments/xrpl/cli.ts status",
    "xrpl:test-payment": "tsx src/payments/xrpl/cli.ts test-payment",
    "xrpl:fund": "tsx src/payments/xrpl/cli.ts fund",
    "xrpl:transactions": "tsx src/payments/xrpl/cli.ts transactions",
    "xrpl:api": "tsx src/payments/xrpl/cli.ts api",
    "test:xrpl-live": "tsx test/live/xrpl-smoke-live.ts",
    "test:reservation-deposit-live": "tsx test/live/reservation-deposit-live.ts",
    "payments:fund-testnet": "tsx scripts/fund-xrpl-testnet.ts",
    "transport:demo": "tsx src/transport/demo.ts",
    "demo:reservation": "tsx src/reservations/demo.ts",
    "demo:restaurant-call": "tsx src/phone/demo.ts",
    "transport:gemini-live": "tsx src/transport/gemini-live.ts",
    "integrations:check": "tsx src/integrations/check.ts",
    "integrations:test-call": "tsx src/integrations/test-call.ts",
    "integrations:test-imessage": "tsx src/integrations/test-imessage.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "dotenv": "^18.0.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "spectrum-ts": "^12.10.1",
    "xrpl": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
