FROM python:3.13-slim

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY scripts ./scripts
COPY sql ./sql
COPY deploy/run-ingest.sh ./deploy/run-ingest.sh
COPY deploy/run-ingest-hourly.sh ./deploy/run-ingest-hourly.sh

RUN chmod +x ./deploy/run-ingest.sh ./deploy/run-ingest-hourly.sh
CMD ["./deploy/run-ingest.sh"]
