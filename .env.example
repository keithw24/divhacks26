# Tiger Cloud
# Paste the connection string from `tiger db connection-string --with-password`
# or from the config file Tiger Console gives you when the service is created.
DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# Public hostname used by the DigitalOcean Docker deployment (no scheme).
DOMAIN=boroughos.example.com

# NYC Open Data dataset IDs:
#   5uac-w243  NYPD Complaint Data Current (Year To Date)  ~280k rows
#   qgea-i56i  NYPD Complaint Data Historic               ~10M rows
NYPD_DATASET=5uac-w243

# Safety queries use a 2-year window. Set INGEST_YEARS=2 to load historic + YTD
# in that window (~0.8–1.2M rows). INGEST_LIMIT=0 means no extra cap.
INGEST_YEARS=2
INGEST_LIMIT=0
PAGE_SIZE=5000

# Photon Spectrum — from https://app.photon.codes (never commit real values)
# SPECTRUM_* wins if both are set. PHOTON_PROJECT_* and PHOTON_ID / PHOTON_SECRET also work.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

BOROUGHOS_AUTOREPLY=true

# ---------------- iMessage agent (TypeScript) ----------------
# Strict judge demo. Refuses to start when a live credential is missing, and
# refuses mock tickets, mock reservation calls, and gazetteer phone numbers.
# Leave this unset for unit tests.
LIVE_DEMO_MODE=
# "terminal" = local chat in your terminal. "imessage" = real iMessage via Photon.
CHAT_PROVIDER=terminal
# In group chats the agent only replies when mentioned by this name (e.g. "@Agent how do I get there?").
AGENT_NAME=Agent
TERMINAL_AS_GROUP=

# Gemini — required for transportation and "what should I do?".
# Google Maps grounding uses this key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 2.5-flash is closed to new keys. 3.8-flash free quota is tiny.
# Maps grounding is paid-only on several 3.x models.
GEMINI_MODEL=gemini-3.5-flash-lite
# Restyles the safety chart image sent over iMessage (checked by GEMINI_MODEL before sending).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
TIMEZONE=America/New_York

# Optional Google Maps Platform key. NOT interchangeable with GEMINI_API_KEY.
# Enables structured Routes/Places for transportation, restaurants, and routing.
# Restrict this key to Places API (New) and Routes API.
# https://console.cloud.google.com/apis/library
GOOGLE_MAPS_API_KEY=

# Optional event-web enrichment. Official NYC feeds remain the source of truth.
TAVILY_API_KEY=
PARKS_EVENTS_DATASET=w3wp-dpdi
PERMITTED_EVENTS_DATASET=tvpp-9vvx

# Backboard — persistent memory, one assistant per person. Server-side only.
# The app still starts without a key; @agent then uses recent chat context only.
# https://app.backboard.io
BACKBOARD_API_KEY=
BACKBOARD_MEMORY_MODE=Auto
BACKBOARD_MEMORY_PRO=false
# Set to true only while debugging. Prints retrieved memory text to the server log.
BACKBOARD_VERBOSE_MEMORY=false

# Restaurant reservations. Default is mock: no real phone call is placed.
# live dials only after the user confirms, and only a number returned by Google Places
# unless RESERVATION_ALLOW_GAZETTEER_DIAL=true.
RESERVATION_CALL_MODE=mock
# exact_time | alternative_within_window | alternative_outside_window | fully_booked
# asks_for_name | asks_for_phone | voicemail | no_answer | api_error | malformed_completion
RESERVATION_MOCK_SCENARIO=alternative_within_window
RESERVATION_ALLOW_GAZETTEER_DIAL=false
RESERVATION_WEBHOOK_PORT=8787
# How long to wait for the post-call webhook before CALL_FAILED. Values under 60000 are ignored.
RESERVATION_CALL_TIMEOUT_MS=600000
# Demo deposit fixtures only. These are not real restaurant policies.
# Flat: {"Carbone":50}
# Party-sized: {"Carbone":{"amountUsd":50,"extraPerPersonUsd":10,"basePartySize":4,"description":"Reservation deposit"}}
# RESERVATION_DEPOSITS_JSON={"Carbone":{"amountUsd":50,"extraPerPersonUsd":10,"basePartySize":4,"description":"Reservation deposit"}}

# ElevenLabs. One key covers outbound reservation calls and voice memos.
# https://elevenlabs.io/docs/api-reference/integrations/twilio/outbound-call
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Phone number id from the ElevenLabs dashboard (agent_phone_number_id).
# ELEVENLABS_PHONE_NUMBER_ID is accepted as an alias.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# HMAC secret from the ElevenLabs post-call webhook. WEBHOOK_SECRET is also accepted.
ELEVENLABS_WEBHOOK_SECRET=
# Twilio Account SID, API key, and the Twilio number are connected in the ElevenLabs
# dashboard (Agents → Phone numbers), not in this app. ElevenLabs places the Twilio call.
# Do not put Twilio secrets here.
# Optional. Your own mobile, used by `npm run demo:restaurant-call` when --phone is omitted.
# A real call still requires --live. Never put a restaurant's number here for the first test.
# RESTAURANT_CALL_TEST_NUMBER=

# Conversational payments. mock is the default and never contacts Ripple or Nessie.
# nessie records a fake USD purchase on Capital One's hackathon API.
# ripple_test submits XRP on XRPL Testnet. nessie_ripple does Nessie then Testnet.
# There is no mainnet or real-money mode.
PAYMENTS_MODE=mock
PAYMENTS_MAX_USD=500
PAYMENTS_DAILY_MAX_USD=1000
PAYMENTS_XRP_PER_USD=1
PAYMENTS_TIMEOUT_MS=20000
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
# Optional. If omitted, BoroughOS creates a Checking wallet named "BoroughOS wallet".
# NESSIE_CUSTOMER_ID=
# NESSIE_ACCOUNT_ID=
# Official Testnet websocket only. Mainnet and Devnet URLs are refused.
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
# Family seed for the Testnet sender. Never commit a real value. Omit it to stay fail-closed.
XRPL_TESTNET_SEED=
# Fund a registered customer (Rohan, Keith, Ben, Sarah) from the Testnet faucet when they have no wallet.
# Unknown names are never provisioned. This cannot target Mainnet.
# To create or top up those wallets before a payment test: npm run faucet
XRPL_AUTO_PROVISION_TESTNET=true
# In ripple_test, chat payments settle between customer wallets. Map each Photon sender id
# (phone number or email) to the customer whose wallet signs. Unmapped senders cannot pay.
# XRPL_CUSTOMER_SENDERS_JSON={"+15551234567":"rohan","keith@example.com":"keith"}
# Read-only JSON feed for the website's XRPL Testnet section (bound to 127.0.0.1).
XRPL_DASHBOARD_PORT=8790
# Operator wallet for xrplPayments.send (restaurant deposits, npm run xrpl:*). Testnet only.
# Any other value, including mainnet, is refused before anything is signed.
XRPL_NETWORK=testnet
# The operator wallet signs with XRPL_TESTNET_SEED when set. Otherwise it uses this customer's existing
# wallet in data/ripple-demo/secrets.json (gitignored). A new wallet is never generated for it.
XRPL_WALLET_CUSTOMER_ID=rohan
# Optional. When set, the loaded wallet must derive to this public address or loading fails.
# XRPL_WALLET_ADDRESS=r...
XRPL_MAX_PAYMENT_XRP=100
XRPL_VALIDATION_TIMEOUT_MS=45000
# npm run xrpl:fund skips the faucet while the wallet holds at least this much test XRP.
XRPL_FAUCET_MIN_BALANCE_XRP=50
# XRPL_TRANSACTIONS_PATH=data/ripple-demo/xrpl-transactions.jsonl
# npm run xrpl:api serves the operator wallet status and transactions (read-only, 127.0.0.1).
XRPL_TRANSACTIONS_API_PORT=8791
# Autonomous agent payments skip the human "yes" only when this is true, the network is Testnet,
# and the amount is within AUTONOMOUS_MAX_USD. Photon person payments still require confirmation.
AUTONOMOUS_PAYMENTS_ENABLED=false
AUTONOMOUS_MAX_USD=25
# Optional JSON map merged over the built-in Keith/Ben/Sarah test addresses.
# PAYMENTS_RECIPIENTS_JSON={"Keith":{"displayName":"Keith","rippleDestination":"r..."}}
# Testnet classic addresses for restaurant deposits. Mock mode does not need this.
# PAYMENTS_MERCHANTS_JSON={"Carbone":"r..."}

# Event tickets. mock uses built-in demo events and never contacts Ticketmaster.
# ticketmaster uses the Discovery API for events and prices (needs TICKETMASTER_API_KEY).
TICKETING_PROVIDER=mock
# mock = demo checkout paid through PAYMENTS_MODE (XRPL Testnet or mock), never a real ticket.
# provider = real purchase through the Ticketmaster Partner API; falls back to link without a partner key.
# link = only return the official checkout link. Default: mock for the mock provider, link for ticketmaster.
TICKETING_PURCHASE_MODE=
TICKETMASTER_API_KEY=
# Only set this if Ticketmaster has granted Partner API access.
TICKETMASTER_PARTNER_API_KEY=
TICKETING_DEFAULT_CITY=New York
# Demo checkout pays this PAYMENTS_MERCHANTS_JSON entry. In ripple_test it must map to a Testnet address.
TICKETING_MERCHANT_NAME=Demo Box Office
# Voice memos. Without a key, voice memos are ignored and replies stay text-only.
# Any voice from your ElevenLabs voice library; defaults to a premade voice.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# smart = voice memo when someone sends one, asks to hear it ("say that out loud"),
#         or is on the move / needs a route right now. Delivery follows their mood.
# match = only when someone sends a voice memo or asks to hear it; always; off
# eleven_v3 as ELEVENLABS_TTS_MODEL also gets an inline delivery tag ([calmly], [cheerfully]).
VOICE_REPLIES=smart

# Website API for the frontend/ site: sign-in codes over iMessage, onboarding, memories.
# WEB_API_PORT=off disables it. The site reads the URL from VITE_AGENT_API_URL (see frontend/.env.example).
WEB_API_HOST=0.0.0.0
WEB_API_PORT=8788
# Comma-separated site origins allowed to call the API.
WEB_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080
WEB_MAX_USERS=100
# Random string (e.g. `openssl rand -hex 32`). Keeps pending login codes valid across restarts.
WEB_AUTH_SECRET=
# The agent's iMessage number. Never shown on the website: it's emailed to users after they verify.
AGENT_NUMBER=+14155951440
APP_NAME=plansaroundus

# Email (sign-in codes + the agent-number email). Any SMTP provider works, e.g. Gmail:
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#   SMTP_PASS=<16-char app password from myaccount.google.com/apppasswords>, EMAIL_FROM="plansaroundus <you@gmail.com>"
# In terminal mode (CHAT_PROVIDER=terminal) emails are printed to the log if SMTP isn't set.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
