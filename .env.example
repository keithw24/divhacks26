# Tiger Cloud
# Paste the connection string from `tiger db connection-string --with-password`
# or from the config file Tiger Console gives you when the service is created.
DATABASE_URL=postgresql://tsdbadmin:PASSWORD@HOST:PORT/tsdb?sslmode=require

# NYC Open Data dataset IDs:
#   5uac-w243  NYPD Complaint Data Current (Year To Date)  ~280k rows
#   qgea-i56i  NYPD Complaint Data Historic               ~10M rows
NYPD_DATASET=5uac-w243

# Start small on a free Tiger service; raise this (or set 0 for all pages) later.
INGEST_LIMIT=20000
PAGE_SIZE=1000

# Photon Spectrum — copy these from https://app.photon.codes
# Photon Spectrum project credentials from https://app.photon.codes
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Start in a safe acknowledgement-only mode. Set true when the agent pipeline is ready.
BOROUGHOS_AUTOREPLY=true

# ---------------- iMessage agent (TypeScript) ----------------
# "terminal" = local chat in your terminal, no credentials. "imessage" = real iMessage via Photon.
CHAT_PROVIDER=terminal
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# In group chats the agent only replies when mentioned by this name (e.g. "@Agent what now?").
AGENT_NAME=Agent
# Treat the terminal chat as a group chat, to test mention handling and group context locally.
TERMINAL_AS_GROUP=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
TIMEZONE=America/New_York
